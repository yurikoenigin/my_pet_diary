<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-xl mx-auto bg-white p-8 rounded-xl shadow-md border border-gray-100">
    
    <%# ヘッダー部分：名前とステータス %>
    <div class="mb-8 flex justify-between items-start">
      <div>
        <h1 class="text-xl font-bold text-gray-900">
          <%= @pet_log.occurred_at.strftime(@pet_log.occurred_at.strftime("%H:%M") == "00:00" ? "%Y/%m/%d" : "%Y/%m/%d %H:%M") %>
        </h1>
        <p class="text-sm text-gray-500"><%= t('.title') %></p>
      </div>
    </div>

    <div class="mb-8">
      <div class="flex flex-row items-center flex-shrink-0">
        <% if @pet_log.pet.image.attached? %>
          <%= image_tag @pet_log.pet.image, class: "w-15 h-15 rounded-full border border-gray-200 object-cover" %>
        <% else %>
          <div class="w-15 h-15 rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
            <svg xmlns="http://www.w3.org" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        <% end %>
        <span class="text-sm text-gray-500 break-all p-2"><%= @pet_log.pet.name %></span>
      </div>
    </div>

    <div class="space-y-6">
      <div class="flex flex-row items-center">
        <% if @pet_log.log_type_id.present? %>
          <span class="font-bold text-gray-800 px-2"><%= @pet_log.log_type.name %></span>
        <% end %>
        <% if @pet_log.weight.present? %>
          <span class="text-blue-700 px-2">
            <span class="text-sm">体重: </span>
            <%= @pet_log.weight %>
            <span class="text-xs"> kg</span>
          </span>
        <% end %>
      </div>
      <div class="mt-2 p-4 bg-gray-50 rounded-xl text-gray-700 leading-relaxed whitespace-pre-wrap break-all"><%= @pet_log.content %></div>
    </div>

    <%# アクションボタン %>
    <div class="mt-10 flex flex-col gap-3">
      <%= link_to t('defaults.go_to_edit'), edit_pet_log_path(@pet_log), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-colors" %>
      <div class="flex justify-between items-center px-1">
        <%= link_to t('defaults.back_to_index'), pet_logs_path, class: "text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors" %>
        <%= link_to t('defaults.destroy'), pet_log_path(@pet_log), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "text-sm font-medium text-red-400 hover:text-red-600 transition-colors" %>
      </div>
    </div>
  
  </div>
</div>
