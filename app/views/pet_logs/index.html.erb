<div class="max-w-3xl container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold text-gray-800"><%= t('header.index_pet_log') %></h1>
    <%= link_to t('defaults.go_to_new'), new_pet_log_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition shadow-sm" %>
  </div>

  <div class="space-y-4">
    <% @pet_logs.each do |log| %>
      <div class="relative bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:border-indigo-300 transition-all duration-300">
        <div class="p-2 flex flex-col sm:flex-row gap-4 items-start">
          
          <div class="flex gap-4 flex-grow min-w-0">
            
            <%# アイコンエリア %>
            <div class="flex flex-col items-center w-16 flex-shrink-0">
              <% if log.pet.image.attached? %>
                <%= image_tag log.pet.image, class: "w-13 h-13 rounded-full border border-gray-200 object-cover" %>
              <% else %>
                <div class="w-13 h-13 rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
                  <svg xmlns="http://www.w3.org" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              <% end %>
              <span class="text-[10px] text-gray-500 break-all text-center w-full"><%= log.pet.name %></span>
            </div>

            <%# テキストエリア %>
            <div class="flex flex-col min-w-0 flex-grow">
              <div class="py-1 text-sm text-gray-500">
                <%= log.occurred_at.strftime(log.occurred_at.strftime("%H:%M") == "00:00" ? "%Y/%m/%d" : "%Y/%m/%d %H:%M") %>
              </div>

              <%# ログタイプとコンテンツの並び %>
              <div class="flex flex-col sm:flex-row gap-x-4 gap-y-1 min-w-0">
                <div class="flex-shrink-0 whitespace-nowrap">
                  <span class="font-bold text-md text-gray-800"><%= log.log_type.name %></span>
                  <% if log.weight.present? %>
                    <span class="ml-2 text-sm text-blue-700">体重: <%= log.weight %> <small>kg</small></span>
                  <% end %>
                </div>
                <div class="min-w-0 flex-grow">
                  <% if log.content.present? %>
                    <div class="pt-1 text-sm text-gray-600 break-words items-center"><%= log.content %></div>
                  <% end %>
                </div>
              </div>

            </div>
          </div>

          <%# 詳細リンク %>
          <div class="flex-shrink-0 self-end sm:self-start pt-2">
            <%= link_to pet_log_path(log), class: "flex items-center text-indigo-600 hover:text-indigo-800 font-bold text-sm" do %>
              <span class="whitespace-nowrap"><%= t('defaults.show') %></span>
              <svg xmlns="http://www.w3.org" class="h-4 w-4 ml-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%# ページネーション（kaminari等を使用している場合） %>
  <div class="mt-6">
    <%#= paginate @pet_logs %>
  </div>
</div>
