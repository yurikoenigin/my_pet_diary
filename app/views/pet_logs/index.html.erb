<div class="max-w-3xl container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold text-gray-800"><%= t('header.index_pet_log') %></h1>
    <%= link_to t('defaults.go_to_new'), new_pet_log_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition shadow-sm" %>
  </div>

  <div class="space-y-4">
    <% @pet_logs.each do |log| %>
      <div class="relative bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:border-indigo-300 transition-all duration-300">
        <%# sm:flex-rowでスマホ画面以外は横並び、中の要素同士はgap-4 %>
        <div class="p-4 flex flex-col sm:flex-row gap-4">
          <%# items-start %>
          <div class="flex items-start gap-4 flex-grow min-w-0">
            <div class="flex flex-col items-center w-15">
              <% if log.pet.image.attached? %>
                <%= image_tag log.pet.image, class: "flex-shrink-0 w-10 h-10 rounded-full border-gray-200 object-cover" %>
              <% else %>
                <div class="text-gray-400 text-[10px] flex items-center">
                  <svg xmlns="http://www.w3.org" class="h-5 w-5 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              <% end %>
              <span class="text-[10px] text-gray-500"><%= log.pet.name %></span>
            </div>
            <div class="flex flex-col">

              <div class="py-1 text-sm text-gray-500"><%= log.occurred_at.strftime("%Y/%m/%d %H:%M") %></div>

              <div class="flex flex-col sm:flex-row gap-4">
                <div>
                  <span class="py-1 font-bold text-md text-gray-800 pr-2"><%= log.log_type.name %></span>
                  <% if log.weight.present? %>
                    <span class="text-sm text-blue-700">体重:</span>
                    <span class="text-blue-700"><%= log.weight %> <small>kg</small></span>
                  <% end %>
                </div>
                <div>
                  <% if log.content.present? %>
                    <span class="text-sm"><%= log.content %></span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
          <div class="flex item-center sm:static sm:flex-shrink-0">
            <%= link_to pet_log_path(log), class: "flex items-center text-indigo-600 hover:text-indigo-800 font-bold text-sm" do %>
              <span><%= t('defaults.show') %></span>
              <svg xmlns="http://www.w3.org" class="h-4 w-4 ml-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            <% end %>
          </div>
        </div>
      </div>

    <% end %>
  </div>

  <%# ページネーション（kaminari等を使用している場合） %>
  <div class="mt-6">
    <%#= paginate @pet_logs %>
  </div>
</div>
