<div class="max-w-3xl container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800"><%= t('header.index_pet_log') %></h1>
    <%= link_to "新しく記録する", new_pet_log_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition shadow-sm" %>
  </div>

  <!-- ペット選択フィルター: 横スクロール対応 -->
  <div class="mb-8">
    <div class="flex items-center gap-4 overflow-x-auto pb-4 scrollbar-hide">
      <!-- 「すべて」ボタン -->
      <%= link_to pet_logs_path, class: "flex-shrink-0 flex flex-col items-center gap-1 group" do %>
        <div class="w-14 h-14 rounded-full border-2 flex items-center justify-center transition-all <%= params[:pet_id].blank? ? 'border-indigo-600 bg-indigo-50 text-indigo-600' : 'border-gray-200 bg-gray-50 text-gray-400 group-hover:border-indigo-300' %>">
          <svg xmlns="http://www.w3.org" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
        </div>
        <span class="text-[11px] font-medium <%= params[:pet_id].blank? ? 'text-indigo-600' : 'text-gray-500' %>">すべて</span>
      <% end %>

      <!-- 各ペットのアイコン -->
      <% @pets.each do |pet| %>
        <%= link_to pet_logs_path(
            pet_id: pet.id,
            log_type_id: params[:log_type_id],
            from_month: params[:from_month],
            to_month: params[:to_month],
            has_weight: params[:has_weight]
          ), class: "flex-shrink-0 flex flex-col items-center gap-1 group" do %>
          <% is_active = params[:pet_id].to_i == pet.id %>
          <div class="w-14 h-14 rounded-full border-2 overflow-hidden transition-all <%= is_active ? 'border-indigo-600 ring-2 ring-indigo-100' : 'border-gray-200 group-hover:border-indigo-300' %>">
            <% if pet.image.attached? %>
              <%= image_tag pet.image, class: "w-full h-full object-cover" %>
            <% else %>
              <div class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-400">
                <svg xmlns="http://www.w3.org" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h.01M10 10h.01M12 16h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            <% end %>
          </div>
          <span class="text-[11px] font-medium truncate w-16 text-center <%= is_active ? 'text-indigo-600' : 'text-gray-500' %>"><%= pet.name %></span>
        <% end %>
      <% end %>
    </div>
  </div>

<div class="mb-8">
  <%= form_with url: pet_logs_path, method: :get, local: true, class: "flex flex-wrap items-center justify-start gap-x-4 gap-y-4" do |f| %>
    <%# 現在のペットIDを維持 %>
    <%= f.hidden_field :pet_id, value: params[:pet_id] if params[:pet_id].present? %>
    
    <!-- ログタイププルダウン -->
    <div class="relative w-full sm:w-48">
      <%= f.select :log_type_id, 
          options_from_collection_for_select(@log_types, :id, :name, params[:log_type_id]), 
          { include_blank: "すべての種別" }, 
          { class: "block w-full pl-3 pr-10 py-2 text-sm border-gray-300 focus:ring-indigo-500 focus:border-indigo-500 rounded-lg shadow-sm appearance-none bg-white",
            onchange: "this.form.submit()" } 
      %>
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-400">
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
      </div>
    </div>

    <!-- 2. 年月範囲 (From - To) -->
    <div class="flex items-center gap-2 bg-gray-50 p-2 rounded-lg border border-gray-200">
      <span class="text-xs text-gray-500">期間:</span>
      <%= f.month_field :from_month, 
          value: params[:from_month], 
          class: "px-2 py-1 text-sm border-gray-300 rounded-md focus:ring-indigo-500",
          onchange: "this.form.submit()" 
      %>
      <span class="text-gray-400 text-sm">〜</span>
      <%= f.month_field :to_month, 
          value: params[:to_month], 
          class: "px-2 py-1 text-sm border-gray-300 rounded-md focus:ring-indigo-500",
          onchange: "this.form.submit()" 
      %>
    </div>

    <!-- 体重ありチェックボックス -->
    <label class="inline-flex items-center cursor-pointer group">
      <div class="relative flex items-center">
        <%= f.check_box :has_weight, 
            { checked: params[:has_weight] == "1", 
              class: "sr-only peer", 
              onchange: "this.form.submit()" }, 
            "1", nil 
        %>
        <%# トグルスイッチ風のデザイン %>
        <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
        <span class="ml-3 text-sm font-medium text-gray-700 group-hover:text-indigo-600 transition-colors">体重ありのみ</span>
      </div>
    </label>
  <% end %>
</div>

  <div class="space-y-4">
    <% if @pet_logs.any? %>
      <% @pet_logs.each do |log| %>
        <%# --- ログカード部分（以前のコードと同じ） --- %>
        <div class="relative bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:border-indigo-300 transition-all duration-300">
          <div class="p-4 flex items-start">
            <div class="flex gap-4 flex-grow min-w-0 pr-16 sm:pr-20">
              <div class="flex flex-col items-center w-16 flex-shrink-0">
                <% if log.pet.image.attached? %>
                  <%= image_tag log.pet.image, class: "w-13 h-13 rounded-full border border-gray-200 object-cover" %>
                <% else %>
                  <div class="w-13 h-13 rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
                    <svg xmlns="http://www.w3.org" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                <% end %>
                <span class="text-[10px] text-gray-500 break-all text-center w-full mt-1"><%= log.pet.name %></span>
              </div>

              <div class="flex flex-col min-w-0 flex-grow">
                <div class="py-1 text-sm text-gray-500">
                  <%= log.occurred_at.strftime(log.occurred_at.strftime("%H:%M") == "00:00" ? "%Y/%m/%d" : "%Y/%m/%d %H:%M") %>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-x-4 gap-y-1 min-w-0">
                  <div class="flex-shrink-0 whitespace-nowrap">
                    <% if log.log_type_id.present? %>
                      <span class="font-bold text-md text-gray-800 mr-2"><%= log.log_type.name %></span>
                    <% end %>
                    <% if log.weight.present? %>
                      <span class="text-sm text-blue-700">体重: <%= log.weight %> <small>kg</small></span>
                    <% end %>
                  </div>
                  <div class="min-w-0 flex-grow">
                    <% if log.content.present? %>
                      <div class="pt-1 text-sm text-gray-600 break-words whitespace-pre-wrap"><%= log.content %></div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
            <div class="absolute right-4 top-4 sm:top-1/2 sm:-translate-y-1/2">
              <%= link_to pet_log_path(log), class: "flex items-center text-indigo-600 hover:text-indigo-800 font-bold text-sm" do %>
                <span class="whitespace-nowrap"><%= t('defaults.show') %></span>
                <svg xmlns="http://www.w3.org" class="h-4 w-4 ml-0.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-12 bg-white rounded-xl border border-dashed border-gray-300 text-gray-500">
        ログが見つかりませんでした。
      </div>
    <% end %>
  </div>
    <div class="mt-6 text-sm text-gray-600">
    <%= paginate @pet_logs %>
  </div>
</div>
