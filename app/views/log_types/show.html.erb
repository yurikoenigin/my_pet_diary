<div class="max-w-2xl mx-auto px-4 py-8">
  <%# メインコンテンツカード %>
  <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-8">
      <div class="flex items-center gap-4 mb-6">
        <div class="w-16 h-16 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @log_type.name %></h1>
          <div class="mt-1">
            <% if @log_type.active %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                <%= t('defaults.active') %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div>
          <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider">
            <%= LogType.human_attribute_name(:description) %>
          </h2>
          <div class="mt-2 p-4 bg-gray-50 rounded-xl text-gray-700 leading-relaxed whitespace-pre-wrap"><%= @log_type.description %></div>
          <div class="p-2 flex justify-between text-xs text-gray-400">
            <p><%= LogType.human_attribute_name(:updated_at) %>: <%= l(@log_type.updated_at, format: :long) %></p>
          </div>
        </div>
      </div>
          <%# アクションボタン %>
      <div class="mt-10 flex flex-col gap-3">
        <%= link_to t('defaults.go_to_edit'), edit_log_type_path(@log_type), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-colors" %>
        <div class="flex justify-between items-center px-1">
          <%= link_to t('defaults.back_to_index'), log_types_path, class: "text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors" %>
          <%= link_to t('defaults.destroy'), log_type_path(@log_type), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "text-sm font-medium text-red-400 hover:text-red-600 transition-colors" %>
        </div>
      </div>
    </div>
  </div>
</div>
