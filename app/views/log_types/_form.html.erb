<%= form_with(model: log_type, class: "space-y-6") do |f| %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, placeholder: "例：食事、散歩", class: "px-2 mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 5, placeholder: "このログ種類についての説明を入力（任意）", class: "px-2 py-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div class="flex items-start">
    <div class="flex items-center h-5">
      <%= f.check_box :active, class: "h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" %>
    </div>
    <div class="ml-3 text-sm">
      <%= f.label :active, class: "font-medium text-gray-700" %>
      <p class="text-gray-500 text-xs"><%= t('defaults.guidance', item: LogType.model_name.human) %></p>
    </div>
  </div>

  <div class="pt-4 flex flex-col gap-3">
    <%= f.submit class: "w-full flex justify-center py-2.5 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors cursor-pointer" %>
  </div>
<% end %>
