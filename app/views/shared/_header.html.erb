<header class="bg-orange-200 p-4">
  <nav class="container mx-auto flex justify-between items-center">
    <a href="/" class="text-2xl text-orange-600 font-bold hover:text-blue-400">My Pet Diary</a>
    <ul class="flex gap-4 items-center">
      <% if user_signed_in? %>
        <!-- ログインしている時 -->
        <!--
        <li class="text-orange-800 font-semibold">
          <%= current_user.name %> さん
        </li>
        -->
        <!-- 1. ログを見る -->
        <li>
          <%= link_to "ログを見る", "#", class: "text-amber-700 font-semibold hover:text-amber-900 transition" %>
        </li>

        <!-- 2. 各種設定 (プルダウン) -->
        <li class="relative" data-controller="dropdown" data-action="click@window->dropdown#hide">
          <button data-action="click->dropdown#toggle" class="flex items-center text-amber-700 font-semibold hover:text-amber-900 focus:outline-none py-2">
            各種設定
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          
          <!-- プルダウンメニュー -->
          <div data-dropdown-target="menu" class="absolute right-0 mt-0 w-48 bg-white rounded-lg shadow-xl py-2 z-50 hidden border border-orange-100">
            <div class="px-4 py-2 text-xs text-gray-500 border-b border-gray-100 mb-1">
              ログイン中: <%= current_user.name %>さん
            </div>
            <%= link_to "ユーザー情報", "#", class: "block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600" %>
            <%= link_to "ペット情報", pets_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600" %>
            <%= link_to "ログ種別情報", "#", class: "block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600" %>
          </div>
        </li>
        <li>
          <%= link_to "ログアウト", destroy_user_session_path, 
              data: { turbo_method: :delete }, 
              class: "inline-block bg-stone-400 text-white px-3 py-1.5 text-sm rounded-full font-semibold hover:bg-stone-500 transition duration-300 shadow-sm" %>
        </li>
      <% else %>
        <!-- ログインしていない時 -->
        <li>
          <%= link_to "新規登録", new_user_registration_path, 
              class: "inline-block bg-orange-400 text-white px-4 py-2 rounded-full font-semibold hover:bg-orange-500 transition duration-300 shadow-md" %>
        </li>
        <li>
          <%= link_to "ログイン", new_user_session_path, 
              class: "inline-block bg-orange-600 text-white px-4 py-2 rounded-full font-semibold hover:bg-orange-700 transition duration-300 shadow-md" %>
        </li>
      <% end %>
    </ul>
  </nav>
</header>
