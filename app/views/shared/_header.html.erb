<header class="bg-orange-200 p-4">
  <nav class="container mx-auto flex justify-between items-center">
    <a href="/" class="text-2xl text-orange-600 font-bold hover:text-blue-400">My Pet Diary</a>
    <ul class="flex gap-4 items-center">
      <% if user_signed_in? %>
        <!-- ログインしている時 -->
        <li class="text-orange-800 font-semibold">
          <%= current_user.name %> さん
        </li>
        <li>
          <%= link_to "ログアウト", destroy_user_session_path, 
              data: { turbo_method: :delete }, 
              class: "inline-block bg-red-400 text-white px-4 py-2 rounded-lg font-semibold hover:bg-red-600 transition duration-300" %>
        </li>
      <% else %>
        <!-- ログインしていない時 -->
        <li>
          <%= link_to "新規登録", new_user_registration_path, 
              class: "inline-block bg-orange-500 text-white px-4 py-2 rounded-lg font-semibold hover:bg-orange-600 transition duration-300" %>
        </li>
        <li>
          <%= link_to "ログイン", new_user_session_path, 
              class: "inline-block bg-neutral-400 text-white px-4 py-2 rounded-lg font-semibold hover:bg-neutral-600 transition duration-300" %>
        </li>
      <% end %>
    </ul>
  </nav>
</header>
