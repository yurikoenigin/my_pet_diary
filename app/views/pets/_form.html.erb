<%= form_with(model: pet, class: "space-y-6") do |f| %>
  <%# 名前 %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <%# 写真アップロード %>
<div class="space-y-4">
  <%= f.label :image, class: "block text-sm font-medium text-gray-700" %>

  <%# --- ここからプレビューエリア --- %>
  <div class="flex items-center gap-4 mb-4">
    <%# 現在の画像 or プレビュー用枠 %>
    <div id="image-preview" class="w-24 h-24 rounded-lg border-2 border-dashed border-gray-200 overflow-hidden bg-gray-50 flex items-center justify-center shrink-0">
      <% if pet.image.attached? && pet.persisted? %>
        <%= image_tag pet.image, class: "w-full h-full object-cover", id: "current-image" %>
      <% else %>
        <svg xmlns="http://www.w3.org" class="h-8 w-8 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      <% end %>
    </div>

    <%# 削除チェックボックス（画像がある時だけ表示） %>
    <% if pet.image.attached? && pet.persisted? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remove_image, class: "rounded border-gray-300 text-red-600 focus:ring-red-500 cursor-pointer" %>
        <%= f.label :remove_image, class: "text-xs text-red-500 font-bold cursor-pointer" %>
      </div>
    <% end %>
  </div>
  <%# --- ここまでプレビューエリア --- %>

  <%# ファイル選択ボタン %>
  <div class="flex text-sm text-gray-600">
    <%= f.file_field :image, 
        class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer", 
        accept: "image/*",
        onchange: "previewImage(this);" %>
  </div>
</div>

<%# JavaScript: 選択した瞬間にプレビューを切り替える %>
<script>
  function previewImage(input) {
    const preview = document.getElementById('image-preview');
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        preview.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">`;
      }
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>

  <%# 性別（ラジオボタン形式） %>
<div>
  <%= f.label :gender, class: "block text-sm font-medium text-gray-700 mb-2" %>
  <div class="flex items-center gap-6 mt-1">
    <%= f.collection_radio_buttons :gender, Pet.genders_i18n, :first, :last do |b| %>
      <div class="flex items-center">
        <%= b.radio_button class: "h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500 cursor-pointer" %>
        <%= b.label class: "ml-2 block text-sm font-medium text-gray-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

  <%# 日付系 %>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :birthday, class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :birthday, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= f.label :adopted_at, class: "block text-sm font-medium text-gray-700" %>
      <%= f.date_field :adopted_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>

  <%# ステータス %>
  <div class="flex items-center">
    <%= f.check_box :active, class: "h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500" %>
    <%= f.label :active, class: "ml-2 block text-sm text-gray-900" %>
  </div>

  <div class="pt-5">
    <%= f.submit class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors" %>
  </div>
<% end %>
