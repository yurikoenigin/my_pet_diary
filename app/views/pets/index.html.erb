<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-2xl font-bold text-gray-800"><%= t('header.index_pet') %></h1>
    <%= link_to t('header.create_pet'), new_pet_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold py-2 px-5 rounded shadow-sm transition duration-300" %>
  </div>

  <div class="space-y-4">
    <% @pets.each do |pet| %>
      <%# カード全体を相対位置に設定 %>
      <div class="relative bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:border-indigo-300 transition-all duration-300">
        <div class="p-4 flex flex-col sm:flex-row sm:items-center gap-4">
          
          <%# 上段：画像と基本情報のセット %>
          <div class="flex items-center gap-4 flex-grow min-w-0">
            <%# 画像エリア %>
            <div class="flex-shrink-0 w-16 h-16 sm:w-20 sm:h-20 bg-gray-100 rounded-lg border border-gray-200 flex items-center justify-center overflow-hidden">
              <% if pet.respond_to?(:image) && pet.image.attached? %>
                <%= image_tag pet.image, class: "object-cover w-full h-full" %>
              <% else %>
                <div class="text-gray-400 text-[10px] flex flex-col items-center">
                  <svg xmlns="http://www.w3.org" class="h-5 w-5 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <%= t('.no_image') %>
                </div>
              <% end %>
            </div>

            <%# 名前・性別・年齢 %>
            <div class="min-w-0 flex-grow">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <h2 class="text-lg font-bold text-gray-900 truncate max-w-[150px] sm:max-w-none">
                  <%= pet.name %>
                </h2>
                <% if pet.gender.present? %>
                  <span class="text-[10px] px-2 py-0.5 rounded-full border <%= gender_class(pet.gender) %> font-bold whitespace-nowrap">
                    <%= pet.gender_i18n %>
                  </span>
                <% end %>
              </div>
              <div class="text-sm text-gray-500 font-medium">
                <% if pet.birthday.present? %>
                  <%= pet.age %>
                <% end %>
                <% if pet.active %>
                  <span class="ml-2 text-[10px] text-green-600 bg-green-50 px-2 py-0.5 rounded-full">
                    <%= t('defaults.active') %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>

          <%# 下段または右側：詳細データ（スマホではマージンをつけて表示） %>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] sm:text-[13px] text-gray-600 border-t sm:border-t-0 pt-3 sm:pt-0">
            <div class="flex items-center whitespace-nowrap">
              <span class="text-gray-400 mr-1.5"><%= Pet.human_attribute_name(:birthday) %>:</span>
              <span class="font-medium"><%= pet.birthday || t('defaults.unregistered') %></span>
            </div>
            <div class="flex items-center whitespace-nowrap">
              <span class="text-gray-400 mr-1.5"><%= Pet.human_attribute_name(:adopted_at) %>:</span>
              <span class="font-medium"><%= pet.adopted_at || t('defaults.unregistered') %></span>
            </div>
          </div>

          <%# 右端：詳細リンク（スマホでは右上に配置する例） %>
          <div class="absolute top-4 right-4 sm:static sm:flex-shrink-0">
            <%= link_to pet_path(pet), class: "flex items-center text-indigo-600 hover:text-indigo-800 font-bold text-sm" do %>
              <span>詳細</span>
              <svg xmlns="http://www.w3.org" class="h-4 w-4 ml-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            <% end %>
          </div>

        </div>
      </div>
    <% end %>
  </div>
</div>
