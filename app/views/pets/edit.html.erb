<div class="min-h-screen bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-md border border-gray-100">
    <div class="mb-8">
      <%# 編集画面であることを示すアイコンとタイトル %>
      <div class="flex items-center justify-center gap-2 mb-2 text-indigo-600">
        <svg xmlns="http://www.w3.org" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        <h1 class="text-2xl font-extrabold text-gray-900">
          ペット情報を編集
        </h1>
      </div>
    </div>

    <%# 既存のフォームを再利用（共通化） %>
    <%= render "form", pet: @pet %>

    <div class="mt-6 flex justify-between items-center px-1">
      <%= link_to "詳細に戻る", pet_path(@pet), class: "text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors" %>
      <%= link_to "一覧へ", pets_path, class: "text-sm font-medium text-gray-400 hover:text-gray-600 transition-colors" %>
    </div>
  </div>
</div>
