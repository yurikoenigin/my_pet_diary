<% if user_signed_in? %>
  <%# ログイン済みならログ一覧へリダイレクト %>
  <script>window.location.href = "<%= pet_logs_path %>";</script>
<% else %>
  <div class="min-h-screen bg-slate-50 text-slate-800 font-sans">
    
    <!-- ヒーローセクション -->
    <header class="bg-white border-b border-slate-200 py-16 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-block bg-orange-100 text-orange-700 px-4 py-1 rounded-full text-sm font-bold mb-4">
          Pet Care Management
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 mb-6 tracking-tight">
          My Pet <span class="text-orange-500">Diary</span>
        </h1>
        <p class="text-lg text-slate-600 mb-10 max-w-2xl mx-auto leading-relaxed">
          ごはん、トイレ、体調管理。日常のお世話を素早くロギング。<br class="hidden md:inline">
          大切なペットの健康を、データで見守るお世話記録アプリ。
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <%= link_to "今すぐ記録をはじめる", new_user_registration_path, 
              class: "px-10 py-4 bg-slate-900 hover:bg-slate-800 text-white font-bold rounded-lg shadow-xl transition duration-200 text-center" %>
          <%= link_to "ログイン", new_user_session_path, 
              class: "px-10 py-4 bg-white border border-slate-300 hover:border-slate-400 text-slate-700 font-bold rounded-lg transition duration-200 text-center" %>
        </div>
      </div>
    </header>

    <!-- 機能紹介（ログ項目）セクション -->
    <section class="max-w-5xl mx-auto py-16 px-4">
      <h2 class="text-center text-2xl font-bold mb-12 text-slate-700">何でもすばやくログに残す</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- 項目1 -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <h3 class="font-bold text-lg mb-2">食事・おやつ</h3>
          <p class="text-sm text-slate-500">あげた時間や量、食いつきの様子をサッと記録。</p>
        </div>
        <!-- 項目2 -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <h3 class="font-bold text-lg mb-2">排泄・体調</h3>
          <p class="text-sm text-slate-500">回数や状態をチェックして、異変にいち早く気づく。</p>
        </div>
        <!-- 項目3 -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
          <h3 class="font-bold text-lg mb-2">通院・体重</h3>
          <p class="text-sm text-slate-500">定期的な測定値や病院の予定をまとめて管理。</p>
        </div>
      </div>
    </section>
  </div>
<% end %>
